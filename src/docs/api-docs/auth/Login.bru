meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseurl}}/api/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "user@example.com",
    "password": "your_password"
  }
}

vars:pre-request {
  baseurl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
