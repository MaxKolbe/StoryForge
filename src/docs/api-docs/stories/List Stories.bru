meta {
  name: List Stories
  type: http
  seq: 2
}

get {
  url: {{baseurl}}/api/v1/stories?page=1&limit=10&orderBy=desc
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  orderBy: desc
}

auth:bearer {
  token: {{access_token}}
}

vars:pre-request {
  baseurl: http://localhost:3000
  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6Im1heGltaWxpYW5vZ2J1YWJvckBnbWFpbC5jb20iLCJzdWIiOiI1OTYyNjJiMy05NDUzLTQ1MzktOWJlOS0xNTliN2ZiYWNjNDQiLCJpYXQiOjE3ODkyNjUyNjQsImV4cCI6MTc4OTI2NzA2NH0.lTUgRfEjX-E12FlOxuPtIoaYtPXQ9EsBv_iAmUBDUmQ
